{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://donkeywork.dev/desktop/contracts/0.1.0/common.schema.json",
  "$defs": {
    "id": {
      "type": "string",
      "format": "uuid"
    },
    "counter": {
      "type": "integer",
      "minimum": 0,
      "maximum": 9007199254740991
    },
    "positiveCounter": {
      "type": "integer",
      "minimum": 1,
      "maximum": 9007199254740991
    },
    "principal": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "issuer",
        "subject"
      ],
      "properties": {
        "issuer": {
          "type": "string",
          "format": "uri",
          "maxLength": 2048
        },
        "subject": {
          "type": "string",
          "minLength": 1,
          "maxLength": 256
        }
      }
    },
    "permission": {
      "enum": [
        "desktop.view",
        "desktop.control",
        "clipboard.read",
        "clipboard.write",
        "terminal.open",
        "terminal.input",
        "desktop.resize"
      ]
    },
    "error": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "code",
        "message",
        "retryable"
      ],
      "properties": {
        "code": {
          "enum": [
            "unsupported_version",
            "invalid_argument",
            "unauthorized",
            "forbidden",
            "expired",
            "replayed_grant",
            "control_conflict",
            "stale_epoch",
            "stale_topology",
            "stale_sequence",
            "not_found",
            "resource_exhausted",
            "history_unavailable",
            "worker_unavailable",
            "decoder_failed"
          ]
        },
        "message": {
          "type": "string",
          "maxLength": 512
        },
        "retryable": {
          "type": "boolean"
        }
      }
    },
    "display": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "displayId",
        "originX",
        "originY",
        "width",
        "height",
        "scale",
        "rotation",
        "primary",
        "cursorEmbedded",
        "availableResolutions",
        "canResize"
      ],
      "properties": {
        "displayId": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128
        },
        "originX": {
          "type": "integer",
          "minimum": -65536,
          "maximum": 65536
        },
        "originY": {
          "type": "integer",
          "minimum": -65536,
          "maximum": 65536
        },
        "width": {
          "type": "integer",
          "minimum": 1,
          "maximum": 16384
        },
        "height": {
          "type": "integer",
          "minimum": 1,
          "maximum": 16384
        },
        "scale": {
          "type": "number",
          "exclusiveMinimum": 0,
          "maximum": 8
        },
        "rotation": {
          "enum": [
            0,
            90,
            180,
            270
          ]
        },
        "primary": {
          "type": "boolean"
        },
        "cursorEmbedded": {
          "type": "boolean"
        },
        "canResize": {
          "type": "boolean"
        },
        "availableResolutions": {
          "type": "array",
          "maxItems": 128,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "width",
              "height"
            ],
            "properties": {
              "width": {
                "type": "integer",
                "minimum": 1,
                "maximum": 16384
              },
              "height": {
                "type": "integer",
                "minimum": 1,
                "maximum": 16384
              }
            }
          }
        }
      }
    }
  }
}
