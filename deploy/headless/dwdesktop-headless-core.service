[Unit]
Description=DonkeyWork daemon for the dedicated virtual desktop
Requires=dwdesktop-headless-xorg.service
After=dwdesktop-headless-xorg.service dwdesktop-headless-session.service
PartOf=dwdesktop-headless.target dwdesktop-headless-xorg.service

[Service]
Type=simple
User=dwdesktop
Group=dwdesktop
Environment=DISPLAY=:99
Environment=XAUTHORITY=/run/dwdesktop/Xauthority
Environment=XDG_RUNTIME_DIR=/run/dwdesktop
UMask=0077
ExecStart=/opt/donkeywork-desktop/bin/dwdesktop-core --config /etc/dwdesktop/headless.json
Restart=on-failure
RestartSec=2
TimeoutStopSec=15
KillMode=control-group
NoNewPrivileges=yes
PrivateDevices=yes
ProtectSystem=strict
ProtectHome=yes
ReadWritePaths=/var/lib/dwdesktop /run/dwdesktop

[Install]
WantedBy=dwdesktop-headless.target
