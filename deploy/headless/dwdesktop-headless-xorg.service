[Unit]
Description=DonkeyWork dedicated virtual Xorg display
PartOf=dwdesktop-headless.target
Before=dwdesktop-headless-session.service dwdesktop-headless-core.service
StartLimitIntervalSec=60
StartLimitBurst=3

[Service]
Type=simple
User=dwdesktop
Group=dwdesktop
StateDirectory=dwdesktop
StateDirectoryMode=0700
RuntimeDirectory=dwdesktop
RuntimeDirectoryMode=0700
Environment=DISPLAY=:99
Environment=XAUTHORITY=/run/dwdesktop/Xauthority
Environment=XDG_RUNTIME_DIR=/run/dwdesktop
Environment=LIBGL_ALWAYS_SOFTWARE=1
Environment=GALLIUM_DRIVER=softpipe
Environment=LP_NUM_THREADS=4
UMask=0077
ExecStartPre=/bin/bash /opt/donkeywork-desktop/headless/prepare-runtime.sh
ExecStart=/usr/lib/xorg/Xorg :99 -config /opt/donkeywork-desktop/headless/xorg-dummy.conf -configdir /opt/donkeywork-desktop/headless/xorg.conf.d -auth /run/dwdesktop/Xauthority -nolisten tcp -noreset -novtswitch -sharevts -seat dwdesktop -logfile /var/lib/dwdesktop/Xorg.99.log
ExecStartPost=/bin/bash /opt/donkeywork-desktop/headless/wait-for-x11.sh
Restart=on-failure
RestartSec=2
TimeoutStartSec=25
TimeoutStopSec=10
KillMode=control-group
NoNewPrivileges=yes
PrivateDevices=no
ProtectSystem=strict
ProtectHome=yes
ReadWritePaths=/var/lib/dwdesktop /run/dwdesktop /tmp

[Install]
WantedBy=dwdesktop-headless.target
